@model Courses.Application.DTOs.AccountViewModels.SignUpViewModel
@{

}


<main class="main">
    <div class="page-title" data-aos="fade">
        <nav class="breadcrumbs">
            <div class="container">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="current">SignUp</li>
                </ol>
            </div>
        </nav>
    </div>
    <!-- Sign Up Section -->
    <section id="signup" class="signup section light-background">
        <div class="container" data-aos="fade-up">
            <div class="section-title text-center">
                <p>Create your account</p>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <form asp-controller="Account" asp-action="Signup" method="post" class="php-email-form shadow p-4 rounded bg-white">
                        <div class="row gy-3">

                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <input asp-for="FirstName" type="text" class="form-control">
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" type="text" class="form-control">
                            </div>

                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label">User Name</label>
                                <input asp-for="UserName" type="text" class="form-control" required>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control" required>
                            </div>

                            <div class="col-12">
                                <label asp-for="Password" class="form-label">Password</label>
                                <input asp-for="Password" type="password" class="form-control" required>
                            </div>

                            <div class="col-12">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" required>
                            </div>

                            <div class="col-12 mt-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="togglePasswords">
                                    Show Passwords
                                </button>
                            </div>

                            <div class="col-12">
                                <div class="form-check mt-3">
                                    <input asp-for="AgreeToTerms" class="form-check-input" type="checkbox" required>
                                    <label class="form-check-label" asp-for="AgreeToTerms">
                                        I agree to the <a asp-controller="Account" asp-action="Terms">Terms & Conditions</a>
                                    </label>
                                </div>
                            </div>

                            <div class="col-12 text-center mt-4">
                                <button type="submit" class="btn btn-primary w-100 py-2">Sign Up</button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
    <!-- /Sign Up Section -->
    <script>
        document.getElementById('togglePasswords').addEventListener('click', function () {
            const passwordFields = [
                document.getElementById('password'),
                document.getElementById('confirm-password')
            ];

            const areHidden = passwordFields[0].type === 'password';

            passwordFields.forEach(field => {
                field.type = areHidden ? 'text' : 'password';
            });

            this.textContent = areHidden ? 'Hide Passwords' : 'Show Passwords';
        });
    </script>

</main>

